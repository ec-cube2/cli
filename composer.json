{
    "name": "ec-cube2/cli",
    "description": "EC-CUBE2 Command.",
    "type": "library",
    "license": "LGPL-3.0",
    "authors": [
        {
            "name": "Tsuyoshi Tsurushima"
        }
    ],
    "autoload": {
        "psr-4": {"Eccube2\\": "src/Eccube2/"}
    },
    "autoload-dev": {
        "psr-4": {"Eccube2\\Tests\\": "tests/"}
    },
    "require": {
        "php": ">=5.5.9",
        "ext-mbstring": "*",
        "symfony/config": "^3.4|^4.4|^5.4",
        "symfony/console": "^3.4|^4.4|^5.4",
        "symfony/event-dispatcher": "^3.4|^4.4|^5.4",
        "symfony/dependency-injection": "^3.4|^4.4|^5.4",
        "symfony/yaml": "^3.4|^4.4|^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5.40 || ^9.6"
    },
    "bin": [
        "bin/eccube"
    ]
}
